#!/usr/bin/python3
"""Additive Fedora RPM transactions on the KrisOS persistent overlay."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import posixpath
import re
import stat
import subprocess
import sys
import tempfile

STATE = Path('/var/lib/krisos')
OWNED = Path('/usr/share/krisos/owned-packages.txt')
IDENTITIES = Path('/usr/share/krisos/owned-nevra.txt')

RPM = '/usr/bin/rpm'
FINDMNT = '/usr/bin/findmnt'
GETENFORCE = '/usr/sbin/getenforce'
LS = '/usr/bin/ls'

# Fedora's UsrMerge compatibility links may legitimately be owned as %dir by
# legacy or third-party RPMs. Keep this allowlist deliberately tiny: only
# aliases that are part of the trusted base filesystem may bypass the generic
# 'existing symlink' rejection for directory entries.
USR_MERGE_DIRECTORY_SYMLINKS = {
    '/usr/sbin': '/usr/bin',
}

# Incoming overlay RPMs must stay application-like.  These namespaces either
# own the immutable base/trust model or can create persistent/boot-time effects
# outside the disposable /usr overlay (sysusers, tmpfiles, units, udev, PAM,
# polkit, kernel/dracut policy, etc.).
PROTECTED_PREFIXES = (
    '/usr/lib/modules',
    '/usr/lib/sysimage',
    '/usr/lib/ostree',
    '/usr/lib/rpm',
    '/usr/share/krisos',
    '/usr/share/dnf5',
    '/usr/share/pki/rpm-gpg',
    '/usr/lib/sysusers.d',
    '/usr/lib/tmpfiles.d',
    '/usr/lib/udev',
    # Protect the whole systemd vendor-policy namespace, including units,
    # presets, networkd configuration and global *.conf.d defaults.
    '/usr/lib/systemd',
    '/usr/lib/firewalld',
    '/usr/lib/selinux',
    '/usr/share/selinux',
    '/usr/lib/pam.d',
    '/usr/lib/security',
    '/usr/lib64/security',
    '/usr/share/polkit-1',
    '/usr/lib/polkit-1',
    '/usr/lib/sysctl.d',
    '/usr/lib/modules-load.d',
    '/usr/lib/modprobe.d',
    '/usr/lib/NetworkManager',
    '/usr/lib/dracut',
    '/usr/lib/kernel',
    '/usr/share/dbus-1/system.d',
    '/usr/share/dbus-1/system-services',
    '/usr/share/factory',
    '/usr/lib/environment.d',
    '/usr/lib/binfmt.d',
    '/usr/etc',
)


def output(*args):
    return subprocess.check_output(args, text=True).strip()


def mount_snapshot():
    """Return the live /usr mount identity used across rk transactions."""
    return output(FINDMNT, '-rn', '-M', '/usr', '-o', 'ID,FSTYPE,OPTIONS')


def names(values):
    """Validate exact package names supplied by users or persisted intent."""
    for value in values:
        if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9+_.-]{0,127}', value) or value.endswith(('.rpm', '.i686', '.x86_64', '.noarch')):
            raise RuntimeError(f'Use an exact package name, without architecture, URL or RPM path: {value}')
    return set(values)


def persisted_names(text):
    """Validate persisted package intent while tolerating blank lines only."""
    return names([line for line in text.splitlines() if line.strip()])


def owned_names(values):
    """Load image-generated RPM names without applying the CLI grammar policy."""
    result = set()
    for value in values:
        if not value or value != value.strip() or any(char.isspace() for char in value) or '\x00' in value:
            raise RuntimeError(f'Invalid immutable package name in {OWNED}: {value!r}')
        result.add(value)
    return result


def atomic(path, contents, mode=0o600):
    fd, temp = tempfile.mkstemp(prefix='.rk-', dir=path.parent)
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, 'w') as stream:
            stream.write(contents)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temp, path)
        sync_dir(path.parent)
    finally:
        if os.path.exists(temp):
            os.unlink(temp)


def sync_dir(path):
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def guard(allow_pending=False):
    mount = mount_snapshot()
    fields = mount.split()
    if len(fields) != 3 or fields[1] != 'overlay':
        raise RuntimeError('A dedicated /usr overlay is required; base-only boot is read-only for rk')
    opts = fields[2].split(',')
    for option in ('rw', 'upperdir=/var/lib/krisos/upper', 'workdir=/var/lib/krisos/work'):
        if option not in opts:
            raise RuntimeError(f'Unexpected /usr mount: missing {option}')
    if not allow_pending and (STATE / 'pending').exists():
        raise RuntimeError('A rebuild is pending; reboot before running another rk transaction')
    if output(GETENFORCE) != 'Enforcing' or 'object_r:usr_t:' not in output(LS, '-Zd', '/usr'):
        raise RuntimeError('SELinux must be enforcing and /usr labeled usr_t')
    dbpath = Path(output(RPM, '--eval', '%{_dbpath}')).resolve()
    if not str(dbpath).startswith('/usr/'):
        raise RuntimeError(f'RPM database is outside the persistent /usr overlay: {dbpath}')
    return mount


def check_base(owned):
    installed = output(RPM, '-qa', '--qf', '%{NAME}\t%{EPOCHNUM}:%{VERSION}-%{RELEASE}.%{ARCH}\n').splitlines()
    actual = {line for line in installed if line.split('\t')[0] in owned}
    expected = set(IDENTITIES.read_text().splitlines())
    if actual != expected:
        missing_or_changed = sorted(expected - actual)
        observed = sorted(actual - expected)
        details = []
        if missing_or_changed:
            details.append('expected but missing/changed: ' + '; '.join(missing_or_changed))
        if observed:
            details.append('observed replacement/change: ' + '; '.join(observed))
        raise RuntimeError('Immutable package identities changed; refusing a transaction (' + ' | '.join(details) + ')')


def validate_plan(rows, owned, remove):
    for name, arch, action in rows:
        if name in owned:
            raise RuntimeError(f'Transaction touches immutable package: {name} ({action})')
        if arch not in ('x86_64', 'noarch'):
            raise RuntimeError(f'Unsupported architecture: {name}.{arch}')
        if action != 'Install' and not (action == 'Remove' and name in remove):
            raise RuntimeError(f'Only additive installs and explicitly requested removals are supported: {name} ({action})')


def harden_repo(repo):
    """Preserve the administrator's enabled state while enforcing RPM signatures."""
    config = repo.get_config()
    config.pkg_gpgcheck = True


def open_transaction_lock():
    """Open the root-only mutation lock without following attacker-controlled links."""
    flags = os.O_RDWR | os.O_CLOEXEC
    if hasattr(os, 'O_NOFOLLOW'):
        flags |= os.O_NOFOLLOW
    try:
        fd = os.open(STATE / 'lock', flags)
    except FileNotFoundError as error:
        raise RuntimeError('KrisOS transaction lock is not initialized; run sudo systemd-tmpfiles --create /usr/lib/tmpfiles.d/krisos.conf') from error
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode):
            raise RuntimeError('KrisOS transaction lock is not a regular file')
        if info.st_uid != 0 or info.st_gid != 0 or stat.S_IMODE(info.st_mode) != 0o600:
            raise RuntimeError('KrisOS transaction lock must be root:root mode 0600')
        return fd
    except Exception:
        os.close(fd)
        raise


def acquire_transaction_lock(fd):
    """Take the exclusive root-only mutation lock and normalize the busy error."""
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError as error:
        raise RuntimeError('Another rk transaction is in progress') from error


def _protected(path):
    return any(path == prefix or path.startswith(prefix + '/') for prefix in PROTECTED_PREFIXES)


def _link_destination(link_path, target):
    if not target:
        raise RuntimeError('RPM symlink has an empty target: ' + link_path)
    if target.startswith('/'):
        return posixpath.normpath(target)
    return posixpath.normpath(posixpath.join(posixpath.dirname(link_path), target))


def _is_allowed_usrmerge_directory_symlink(filename, file):
    """Return True only for an exact trusted UsrMerge directory alias."""
    expected = USR_MERGE_DIRECTORY_SYMLINKS.get(filename)
    if expected is None or not file.is_symlink():
        return False
    try:
        link_target = _link_destination(filename, os.readlink(file))
        resolved = str(file.resolve(strict=False))
    except (OSError, RuntimeError):
        return False
    return link_target == expected and resolved == expected


def _is_identical_root_symlink(file, target):
    """Allow a pre-existing symlink only when it is an exact root-owned match."""
    if not file.is_symlink():
        return False
    try:
        info = file.lstat()
        return info.st_uid == 0 and info.st_gid == 0 and os.readlink(file) == target
    except OSError:
        return False


def _reject_nested_manifest_symlinks(links):
    """Reject symlink entries whose pathname is below another incoming symlink.

    Such payloads are order-dependent: the child symlink is physically created
    below the ancestor's resolved target, so its relative target is no longer
    interpreted from the pathname recorded in the RPM manifest.  Refusing this
    shape keeps validation identical to the filesystem semantics instead of
    trying to emulate an RPM extraction order.
    """
    for path in links:
        parent = posixpath.dirname(path)
        while parent.startswith('/usr/'):
            if parent in links:
                raise RuntimeError(
                    'Nested incoming symlinks are not supported: '
                    + path + ' is below ' + parent
                )
            parent = posixpath.dirname(parent)


def _resolve_manifest_links(path, links):
    # Resolve ancestors created as symlinks by this same incoming RPM.  The live
    # filesystem alone cannot detect this before installation because those
    # symlinks do not exist yet.  Cap substitutions to reject cycles.
    current = posixpath.normpath(path)
    for _ in range(len(links) + 1):
        parts = current.split('/')
        replaced = False
        for index in range(2, len(parts) + 1):
            prefix = '/'.join(parts[:index]) or '/'
            if prefix not in links:
                continue
            suffix = '/'.join(parts[index:])
            target = _link_destination(prefix, links[prefix])
            current = posixpath.normpath(posixpath.join(target, suffix))
            replaced = True
            break
        if not replaced:
            return current
    raise RuntimeError('RPM payload contains a symlink cycle affecting: ' + path)


def _read_payload_manifest(path):
    for flag in ('--scripts', '--triggers', '--filetriggers'):
        if output(RPM, '-qp', flag, path):
            raise RuntimeError('Package scriptlets/triggers are not supported in this release: ' + path)

    # Preserve empty trailing FILELINKTOS/FILECAPS fields; output().strip()
    # would corrupt the four-column record for the final manifest entry.
    listing = subprocess.check_output(
        (
            RPM, '-qp', '--qf',
            '[%{FILENAMES}\t%{FILEMODES:octal}\t%{FILEUSERNAME}\t%{FILEGROUPNAME}\t%{FILELINKTOS}\t%{FILECAPS}\n]', path,
        ),
        text=True,
    )
    entries = []
    links = {}
    for line in listing.splitlines():
        fields = line.split('\t')
        if len(fields) != 6:
            raise RuntimeError('Malformed RPM file manifest: ' + line)
        filename, mode_text, owner, group, link_target, file_caps = fields
        file = Path(filename)
        try:
            mode = int(mode_text, 8)
        except ValueError as error:
            raise RuntimeError('Malformed RPM file mode: ' + line) from error
        if not filename.startswith('/usr/') or '..' in file.parts or posixpath.normpath(filename) != filename:
            raise RuntimeError('Package payload outside canonical /usr: ' + filename)
        file_type = stat.S_IFMT(mode)
        directory = file_type == stat.S_IFDIR
        symlink = file_type == stat.S_IFLNK
        regular = file_type == stat.S_IFREG
        if not (regular or directory or symlink):
            raise RuntimeError('Special files are not supported in additive RPM payloads: ' + filename)
        if mode & (stat.S_ISUID | stat.S_ISGID):
            raise RuntimeError('setuid/setgid files are not supported in additive RPM payloads: ' + filename)
        if owner != 'root' or group != 'root':
            raise RuntimeError('Non-root RPM ownership is not supported in additive payloads: ' + filename)
        if not symlink and mode & (stat.S_IWGRP | stat.S_IWOTH):
            raise RuntimeError('Group/world-writable paths are not supported in additive RPM payloads: ' + filename)
        if file_caps not in ('', '(none)'):
            raise RuntimeError('File capabilities are not supported in additive RPM payloads: ' + filename)
        if symlink:
            links[filename] = link_target
        elif link_target:
            raise RuntimeError('Non-symlink RPM entry unexpectedly has a link target: ' + filename)
        entries.append((filename, file, directory, symlink, link_target, mode, owner, group, path))
    return entries, links


def validate_payloads(paths):
    """Validate all incoming RPMs as one future filesystem graph."""
    entries = []
    links = {}
    seen = {}
    for path in paths:
        package_entries, package_links = _read_payload_manifest(path)
        for filename, _file, directory, symlink, link_target, mode, owner, group, _package_path in package_entries:
            signature = (directory, symlink, link_target, stat.S_IMODE(mode), owner, group)
            previous = seen.get(filename)
            if previous is not None and previous != signature:
                raise RuntimeError('Incoming RPMs define incompatible entries for the same path: ' + filename)
            seen[filename] = signature
            if symlink:
                previous_target = links.get(filename)
                if previous_target is not None and previous_target != link_target:
                    raise RuntimeError('Incoming RPMs define conflicting symlinks: ' + filename)
                links[filename] = link_target
        entries.extend(package_entries)

    _reject_nested_manifest_symlinks(links)

    for filename, file, directory, symlink, link_target, mode, owner, group, _package_path in entries:
        if symlink:
            destination = _resolve_manifest_links(_link_destination(filename, link_target), links)
            destination = str(Path(destination).resolve(strict=False))
            if not destination.startswith('/usr/'):
                raise RuntimeError('Package symlink resolves outside /usr: ' + filename)
            if _protected(destination):
                raise RuntimeError('Package symlink reaches protected or persistent state: ' + filename)

        resolved = _resolve_manifest_links(filename, links)
        resolved = str(Path(resolved).resolve(strict=False))
        if not resolved.startswith('/usr/') or _protected(resolved):
            raise RuntimeError('Package payload reaches protected or persistent state: ' + filename)

        if os.path.lexists(file):
            existing_symlink = file.is_symlink()
            if symlink and existing_symlink and _is_identical_root_symlink(file, link_target):
                continue
            allowed_usrmerge = (
                directory
                and existing_symlink
                and _is_allowed_usrmerge_directory_symlink(filename, file)
            )
            if not (directory and file.is_dir() and (not existing_symlink or allowed_usrmerge)):
                raise RuntimeError('Additive package would overwrite an existing path: ' + filename)
            info = file.stat()
            payload_mode = stat.S_IMODE(mode)
            live_mode = stat.S_IMODE(info.st_mode)
            if info.st_uid != 0 or info.st_gid != 0:
                raise RuntimeError('Existing /usr directory has unsafe ownership: ' + filename)
            if owner != 'root' or group != 'root' or live_mode != payload_mode:
                raise RuntimeError('RPM directory metadata does not match existing /usr directory: ' + filename)
            if live_mode & (stat.S_IWGRP | stat.S_IWOTH):
                raise RuntimeError('Existing /usr directory has unsafe mode: ' + filename)


def validate_payload(path):
    """Compatibility wrapper for single-RPM callers and unit tests."""
    validate_payloads([path])


def print_plan(requested, incoming):
    requested_names = set(requested)
    requested_packages = sorted((pkg for pkg in incoming if pkg.get_name() in requested_names), key=lambda pkg: pkg.get_nevra())
    dependencies = sorted((pkg for pkg in incoming if pkg.get_name() not in requested_names), key=lambda pkg: pkg.get_nevra())
    if requested_packages:
        print('Installing:')
        for pkg in requested_packages:
            print('  ' + pkg.get_nevra())
    if dependencies:
        print('Installing dependencies:')
        for pkg in dependencies:
            print('  ' + pkg.get_nevra())
    print('Transaction Summary:')
    print(f'Install {len(incoming)} package(s)')


def load_intent():
    try:
        return persisted_names((STATE / 'packages.list').read_text())
    except FileNotFoundError as error:
        raise RuntimeError('KrisOS package state is not initialized; run sudo systemd-tmpfiles --create /usr/lib/tmpfiles.d/krisos.conf') from error


def forget_requests(requested):
    """Drop unrecoverable intent without removing installed RPMs or clearing recovery."""
    guard()
    if not (STATE / 'needs-sync').exists():
        raise RuntimeError('forget is only available during recovery; use rk rm normally')
    owned = owned_names(OWNED.read_text().splitlines())
    intent = load_intent()
    if requested - intent:
        raise RuntimeError('Only saved package requests can be forgotten')
    check_base(owned)
    installed = set(output(RPM, '-qa', '--qf', '%{NAME}\n').splitlines())
    if requested & (installed - owned):
        raise RuntimeError('Cannot forget an installed overlay package; no requests changed')
    atomic(STATE / 'packages.list', ''.join(n + '\n' for n in sorted(intent - requested)), mode=0o644)
    print('Recovery requests updated; no RPMs removed. Run sudo rk sync to finish recovery.')


def refresh_overlay():
    """Validate saved requests against current repositories, then rebuild on reboot."""
    owned = owned_names(OWNED.read_text().splitlines())
    intent = load_intent()
    if (STATE / 'pending').exists():
        raise RuntimeError('A rebuild is pending; reboot before running another rk transaction')
    if (STATE / 'needs-sync').exists():
        raise RuntimeError('Package recovery is already pending; run sudo rk sync first')

    before = guard()
    check_base(owned)

    # Reconcile requests that have moved into the immutable image. rk sync
    # already excludes intent entries now owned by the base, so keeping them in
    # packages.list would only preserve dead state. This independently valid,
    # idempotent cleanup happens after mount/base validation and remains valid
    # even if the subsequent repository solve fails.
    superseded = intent & owned
    if superseded:
        intent -= superseded
        atomic(
            STATE / 'packages.list',
            ''.join(name + '\n' for name in sorted(intent)),
            mode=0o644,
        )
        print(
            'Dropped requests now provided by the base image: '
            + ', '.join(sorted(superseded))
        )

    if not intent:
        if superseded:
            print('All requests are now provided by the base image; nothing to refresh.')
        else:
            print('No saved package requests; nothing to refresh.')
        return

    import libdnf5
    base = libdnf5.base.Base()
    base.load_config()
    config = base.get_config()
    config.plugins = False
    config.installroot = '/'
    config.install_weak_deps = False
    config.clean_requirements_on_remove = False
    config.excludepkgs = sorted(owned) + ['*.i686']
    config.tsflags = []
    config.system_state_dir = '/usr/lib/sysimage/libdnf5'
    config.pkg_gpgcheck = True
    config.localpkg_gpgcheck = True
    base.setup()

    if not base.lock_system_repo():
        raise RuntimeError('Another package transaction holds the DNF system lock')
    try:
        check_base(owned)
        sack = base.get_repo_sack()
        sack.create_repos_from_system_configuration()
        for repo in libdnf5.repo.RepoQuery(base):
            harden_repo(repo)
        sack.load_repos()

        installed_names = set(output(RPM, '-qa', '--qf', '%{NAME}\n').splitlines())
        missing_installed = intent - installed_names
        if missing_installed:
            raise RuntimeError('Saved package requests are not installed: ' + ', '.join(sorted(missing_installed)))

        unavailable = []
        for name in sorted(intent):
            query = libdnf5.rpm.PackageQuery(base)
            query.filter_available()
            query.filter_name(name)
            if not any(pkg.get_arch() in ('x86_64', 'noarch') for pkg in query):
                unavailable.append(name)
        if unavailable:
            raise RuntimeError('Saved package requests are unavailable in enabled repositories: ' + ', '.join(unavailable))

        if guard() != before or load_intent() != intent:
            raise RuntimeError('KrisOS state changed during refresh validation; retry')
        if (STATE / 'pending').exists() or (STATE / 'needs-sync').exists():
            raise RuntimeError('KrisOS recovery state changed during refresh validation; retry')
        check_base(owned)
        atomic(STATE / 'pending', 'Refresh requested: rebuild overlay after reboot\n')
        sync_dir(STATE)
        print('Refresh armed. Reboot to rebuild the overlay with current repositories.')
    finally:
        base.unlock_system_repo()


def transact(command, requested, dry_run=False):
    import libdnf5
    owned = owned_names(OWNED.read_text().splitlines())
    intent = load_intent()
    if (STATE / 'pending').exists():
        raise RuntimeError('A rebuild is pending; reboot before running another rk transaction')
    if command != 'sync' and (STATE / 'needs-sync').exists():
        raise RuntimeError('Run rk sync first; if an unavailable request blocks recovery, use sudo rk forget NAME, then sudo rk sync')
    if command == 'add' and requested & owned:
        raise RuntimeError('Already owned by the image: ' + ', '.join(sorted(requested & owned)))
    if command == 'rm' and (requested & owned or requested - intent):
        raise RuntimeError('Only explicitly added, non-base packages can be removed')
    target = intent | requested if command == 'add' else intent - requested if command == 'rm' else intent
    install = (requested if command == 'add' else intent if command == 'sync' else set()) - owned
    remove = requested if command == 'rm' else set()
    before = guard()
    check_base(owned)
    if not install and not remove:
        if dry_run:
            print('Nothing to install; package request is already satisfied.')
            return
        atomic(STATE / 'packages.list', ''.join(n + '\n' for n in sorted(target)), mode=0o644)
        (STATE / 'needs-sync').unlink(missing_ok=True)
        sync_dir(STATE)
        print('Nothing to install; package intent synchronized.')
        return
    base = libdnf5.base.Base()
    base.load_config()
    config = base.get_config()
    config.plugins = False
    config.installroot = '/'
    config.install_weak_deps = False
    config.clean_requirements_on_remove = False
    config.excludepkgs = sorted(owned) + ['*.i686']
    config.tsflags = []
    config.system_state_dir = '/usr/lib/sysimage/libdnf5'
    config.pkg_gpgcheck = True
    config.localpkg_gpgcheck = True
    base.setup()
    if not dry_run and not base.lock_system_repo():
        raise RuntimeError('Another package transaction holds the DNF system lock')
    try:
        check_base(owned)
        sack = base.get_repo_sack()
        sack.create_repos_from_system_configuration()
        for repo in libdnf5.repo.RepoQuery(base):
            harden_repo(repo)
        sack.load_repos()
        goal = libdnf5.base.Goal(base)
        for name in sorted(install):
            goal.add_rpm_install(name)
        for name in sorted(remove):
            goal.add_rpm_remove(name)
        tx = goal.resolve()
        if tx.get_problems() != libdnf5.base.GoalProblem_NO_PROBLEM:
            raise RuntimeError('\n'.join(tx.get_resolve_logs_as_strings()))
        items = list(tx.get_transaction_packages())
        if not items:
            if dry_run:
                print('Nothing to install; package request is already satisfied.')
                return
            atomic(STATE / 'packages.list', ''.join(n + '\n' for n in sorted(target)), mode=0o644)
            (STATE / 'needs-sync').unlink(missing_ok=True)
            sync_dir(STATE)
            print('Nothing to install; package intent synchronized.')
            return
        rows = []
        incoming = []
        for item in items:
            pkg = item.get_package()
            action = libdnf5.base.transaction.transaction_item_action_to_string(item.get_action())
            rows.append((pkg.get_name(), pkg.get_arch(), action))
            if action == 'Install':
                incoming.append(pkg)
        validate_plan(rows, owned, remove)
        if not dry_run:
            for item in items:
                pkg = item.get_package()
                action = libdnf5.base.transaction.transaction_item_action_to_string(item.get_action())
                print(action, pkg.get_nevra(), flush=True)
        installed_names = set(output(RPM, '-qa', '--qf', '%{NAME}\n').splitlines())
        if install - installed_names - {p.get_name() for p in incoming}:
            raise RuntimeError('Request must resolve to that exact package name, not a capability or NEVRA')
        if dry_run:
            if guard() != before or load_intent() != intent:
                raise RuntimeError('KrisOS state changed during plan; retry')
            print_plan(requested, incoming)
            return
        tx.download()
        if not tx.check_gpg_signatures():
            raise RuntimeError('RPM signature verification failed; no transaction applied')
        validate_payloads([pkg.get_package_path() for pkg in incoming])
        if int(tx.test()) != 0:
            raise RuntimeError('RPM transaction test failed; no transaction applied')
        if guard() != before:
            raise RuntimeError('/usr mount changed during transaction preparation')
        atomic(STATE / 'pending', 'Rebuild overlay from packages.list after reboot\n')
        result = tx.run()
        if int(result) != 0:
            raise RuntimeError('RPM transaction failed: ' + tx.transaction_result_to_string(result))
        check_base(owned)
        after = mount_snapshot()
        if after != before:
            raise RuntimeError('/usr mount changed during RPM transaction')
        for name in install:
            subprocess.run([RPM, '-q', name], check=True)
        for name in remove:
            if subprocess.run([RPM, '-q', name], stdout=subprocess.DEVNULL).returncode == 0:
                raise RuntimeError('Requested removal did not complete: ' + name)
        atomic(STATE / 'packages.list', ''.join(n + '\n' for n in sorted(target)), mode=0o644)
        (STATE / 'pending').unlink()
        (STATE / 'needs-sync').unlink(missing_ok=True)
        sync_dir(STATE)
        print('Transaction complete. Requests saved for this and future deployments.')
    finally:
        if not dry_run:
            base.unlock_system_repo()


def status_payload():
    payload = {
        'schema': 1,
        'overlay': 'degraded',
        'mount': '',
        'overlay_error': '',
        'state_error': '',
        'pending_recovery': (STATE / 'pending').exists(),
        'needs_sync': (STATE / 'needs-sync').exists(),
        'requests': [],
    }
    try:
        payload['mount'] = guard(allow_pending=True)
        payload['overlay'] = 'ready'
    except (RuntimeError, OSError, subprocess.CalledProcessError) as error:
        payload['overlay_error'] = str(error)

    package_file = STATE / 'packages.list'
    if package_file.exists():
        try:
            payload['requests'] = sorted(persisted_names(package_file.read_text()))
        except (RuntimeError, OSError, UnicodeError) as error:
            payload['state_error'] = str(error)
            payload['overlay'] = 'degraded'
    return payload


def show_status(json_output=False):
    payload = status_payload()
    if json_output:
        print(json.dumps(payload, separators=(',', ':'), sort_keys=True))
        return

    print('Overlay:', payload['overlay'])
    if payload['mount']:
        print('Mount:', payload['mount'])
    if payload['overlay_error']:
        print('Overlay error:', payload['overlay_error'])
    if payload['state_error']:
        print('State error:', payload['state_error'])
    print('Pending recovery:', payload['pending_recovery'])
    print('Needs sync:', payload['needs_sync'])
    for package in payload['requests']:
        print(package)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command', choices=('add', 'rm', 'sync', 'status', 'plan', 'forget', 'refresh'))
    parser.add_argument('packages', nargs='*')
    parser.add_argument('--json', action='store_true', help='emit versioned JSON for status')
    args = parser.parse_args()
    if args.json and args.command != 'status':
        parser.error('--json is only valid with status')
    takes_packages = args.command in ('add', 'rm', 'plan', 'forget')
    if bool(args.packages) != takes_packages:
        parser.error('add/rm/plan/forget require package names; sync/status/refresh take no packages')
    requested = names(args.packages)
    if args.command == 'status':
        show_status(json_output=args.json)
        return
    if args.command == 'plan':
        guard()
        load_intent()
        # Unprivileged readers must never be able to block the root-only
        # mutation lock. The dry-run path rechecks mount + intent before output.
        transact('add', requested, dry_run=True)
        return
    if os.geteuid() != 0:
        raise RuntimeError('Run with sudo')
    lock = open_transaction_lock()
    try:
        acquire_transaction_lock(lock)
        guard()
        load_intent()
        if args.command == 'forget':
            forget_requests(requested)
        elif args.command == 'refresh':
            refresh_overlay()
        else:
            transact(args.command, requested)
    finally:
        os.close(lock)


def _single_line_error(error):
    """Flatten exception text so each CLI failure remains one journal record."""
    return ' '.join(str(error).splitlines()).strip()


def entrypoint():
    try:
        main()
    except (RuntimeError, OSError, subprocess.CalledProcessError) as error:
        message = _single_line_error(error) or type(error).__name__
        print('rk:', message, file=sys.stderr)
        return 1
    except Exception as error:
        # libdnf5's modern SWIG bindings expose independent Exception branches
        # (for example NonLibdnf5Exception) rather than RuntimeError only. Keep
        # the CLI/service boundary traceback-free without swallowing SystemExit
        # or KeyboardInterrupt, which inherit directly from BaseException.
        message = _single_line_error(error)
        if message:
            print('rk:', type(error).__name__, message, file=sys.stderr)
        else:
            print('rk:', type(error).__name__, file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(entrypoint())
